generator client {
  provider = "prisma-client-js"
}

datasource db {
  // SQLite for development. Switch to PostgreSQL/MySQL in production by
  // changing the provider and DATABASE_URL.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Villa {
  id            String    @id @default(cuid())
  slug          String    @unique
  name          String
  pricePerNight Int // IDR
  maxGuests     Int
  bedrooms      Int
  sizeSqm       Int
  totalUnits    Int       @default(1)
  bookings      Booking[]
}

model Booking {
  id              String   @id @default(cuid())
  bookingCode     String   @unique
  villa           Villa    @relation(fields: [villaId], references: [id])
  villaId         String
  checkIn         DateTime
  checkOut        DateTime
  guests          Int
  guestName       String
  email           String
  phone           String
  specialRequests String?
  nights          Int
  totalAmount     Int // IDR
  currency        String   @default("IDR")
  // PENDING_PAYMENT -> CONFIRMED (after payment webhook) | CANCELLED | EXPIRED
  status          String   @default("PENDING_PAYMENT")
  // Filled in by the payment gateway integration (Midtrans/Xendit/Stripe)
  paymentProvider String?
  paymentRef      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
