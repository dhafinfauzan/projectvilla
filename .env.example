# Database — SQLite for development. Use PostgreSQL/MySQL in production.
DATABASE_URL="file:./dev.db"

# Public site origin — used for sitemap URLs and payment redirect-back links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# VillaOS bootstrap owner. ADMIN_KEY is hashed into the database by the seed;
# staff sign-in uses ADMIN_EMAIL + that password. Remove ADMIN_KEY from the
# production runtime after the first seed if you do not want seed reruns to
# rotate the owner password.
ADMIN_EMAIL="admin@thetaruvillas.local"
ADMIN_NAME="VillaOS Owner"
ADMIN_KEY=""

# Local setup defaults to realistic sample operations. Set false before
# seeding a clean production PostgreSQL database.
SEED_DEMO_DATA="true"

# "local" uses VillaOS/Prisma as the PMS. Set "qloapps" only while running
# the legacy backend during migration or rollback.
PMS_BACKEND="local"

# ── Payment gateway ──────────────────────────────────────────────────────
# "mock" (default) skips payment entirely; set to "midtrans" or "xendit"
# and fill in the matching keys to take real payments.
PAYMENT_PROVIDER="mock"

# Midtrans (https://dashboard.midtrans.com -> Settings -> Access Keys)
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
# "false" = sandbox (app.sandbox.midtrans.com), "true" = production keys.
MIDTRANS_IS_PRODUCTION="false"

# Xendit QRIS — Payment Requests V2 (server-side only).
# Secret key: dashboard.xendit.co -> Settings -> API Keys (xnd_development_… / xnd_production_…)
XENDIT_SECRET_KEY=""
# Webhook verification token: dashboard.xendit.co -> Settings -> Webhooks.
# Set the webhook URL to https://<your-domain>/api/xendit/webhook
XENDIT_WEBHOOK_TOKEN=""

# ── Legacy QloApps backend (migration/rollback only) ────────────────────────
# Used only when PMS_BACKEND="qloapps". Put real values in .env.local.
QLOAPPS_API_URL=""
QLOAPPS_API_KEY=""
# Optional overrides:
QLOAPPS_ID_HOTEL="1"
# Confirm valid status codes via GET /api/bookings?schema=synopsis (logged
# by /api/submit-booking) before relying on these defaults.
QLOAPPS_BOOKING_STATUS="1"
QLOAPPS_PAYMENT_STATUS="0"
